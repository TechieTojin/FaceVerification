# FaceVerification 3.0 configuration — copy to .env and fill in. .env is gitignored; never commit it.

# ── Required (web platform) ────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this key up securely: without it, stored templates cannot be decrypted.
EMBEDDING_ENCRYPTION_KEY=

# First administrator — created only when the users table is empty. Change the password after first sign-in.
INITIAL_ADMIN_EMAIL=admin@example.local
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=System Administrator

# ── Environment ────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | production   (test is for automated tests only)
LOG_LEVEL=INFO
LOG_FORMAT=text                     # text | json

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./faceverification.db
# DATABASE_URL=postgresql+psycopg://faceverification:CHANGE_ME@localhost:5432/faceverification
AUTO_MIGRATE=true                   # apply migrations at start-up (SQLite is backed up first)
BACKUP_DIR=backups
POSTGRES_PASSWORD=                  # used by docker-compose.yml

# ── HTTP / cookies ─────────────────────────────────────────────────────────────
COOKIE_SECURE=false                 # true behind HTTPS (required in production)
COOKIE_SAMESITE=strict
CORS_ORIGINS=["http://localhost:5173"]
FORWARDED_ALLOW_IPS=127.0.0.1       # reverse-proxy address trusted for X-Forwarded-For (container image)

# ── Inference ──────────────────────────────────────────────────────────────────
INFERENCE_WORKERS=2
INFERENCE_QUEUE_LIMIT=8
WARMUP_MODELS=true
# MODELS_DIR=./models               # face_landmarker.task (python scripts/fetch_models.py)

# ── Login protection ───────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_PER_ACCOUNT=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION_SECONDS=300

# ── v4: public address, passkeys, email ────────────────────────────────────────
# Address people use to reach the web UI (QR codes, hosted verification links, emails).
PUBLIC_BASE_URL=http://localhost:5173
# Passkeys: RP ID is the registrable domain of every allowed origin (browsers reject IP addresses).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=["http://localhost:5173"]
WEBAUTHN_RP_NAME=FaceVerification
# Outbound email for notifications, invitations and email sign-in codes. Leave SMTP_HOST empty to disable:
# the UI then reports email as unavailable instead of pretending to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=FaceVerification <no-reply@example.com>
# Integration API / webhooks
API_RATE_LIMIT_PER_MINUTE=60
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
ASSERTION_TTL_SECONDS=300
# Offline kiosks: hard ceiling (hours) for any kiosk's offline validity
OFFLINE_MAX_VALIDITY_HOURS=72

# Verification policy (thresholds, liveness, attempts, retention …) is NOT configured here:
# it is versioned in the database and edited on the Policy settings page.

# ── Desktop CLI (v1.3) only ────────────────────────────────────────────────────
REFERENCE_IMAGE_PATH=
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
RECOGNITION_MODEL=ArcFace
DETECTOR_BACKEND=opencv
ENABLE_LIVENESS=true
INFERENCE_INTERVAL_MS=500
RESULT_EXPIRY_MS=1500
MAX_VERIFICATION_ATTEMPTS=10
ENABLE_PERFORMANCE_OVERLAY=true
