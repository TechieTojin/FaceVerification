# FaceVerification v1.3 configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Required ──────────────────────────────────────────────────────────────────

# Full path to the reference face image (the person to authenticate)
# Windows example: C:\Users\YourName\Pictures\my_face.jpg
REFERENCE_IMAGE_PATH=

# ── Camera ────────────────────────────────────────────────────────────────────

# Camera device index (0 = default webcam, 1 = second camera, etc.)
CAMERA_INDEX=0

# Camera resolution (driver may override with nearest supported value)
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# ── Recognition model ─────────────────────────────────────────────────────────

# DeepFace recognition model: ArcFace (default), VGG-Face, Facenet, Facenet512, SFace
RECOGNITION_MODEL=ArcFace

# Face detector backend: opencv (fastest, no extra download), retinaface, ssd, mtcnn, mediapipe
DETECTOR_BACKEND=opencv

# ── Anti-spoofing (liveness) ──────────────────────────────────────────────────

# Enable passive liveness check (anti-spoofing). Set to false only for development/testing.
# WARNING: disabling liveness removes the primary defence against photo and screen replay attacks.
ENABLE_LIVENESS=true

# ── Verification timing ───────────────────────────────────────────────────────

# Time between inference calls in milliseconds (default 500 = 2 inferences/second)
INFERENCE_INTERVAL_MS=500

# How long a VERIFIED result stays valid in milliseconds (default 1500ms)
# Shorter = more secure, more re-authentication burden
RESULT_EXPIRY_MS=1500

# Maximum consecutive failed verification attempts before logging a warning
MAX_VERIFICATION_ATTEMPTS=10

# ── Display ───────────────────────────────────────────────────────────────────

# Show FPS / inference latency HUD overlay
ENABLE_PERFORMANCE_OVERLAY=true

# ── Logging ───────────────────────────────────────────────────────────────────

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
