# FaceVerification configuration
# Copy this file to .env and fill in your values
# Never commit .env to git

# Path to the reference image of the person to verify against
# Windows example: C:\Users\YourName\Pictures\reference.jpg
REFERENCE_IMAGE_PATH=

# Camera index (0 = default webcam, 1 = second camera, etc.)
CAMERA_INDEX=0

# DeepFace model to use: VGG-Face, Facenet, Facenet512, ArcFace, SFace
FACE_MODEL=ArcFace

# Detector backend: opencv, retinaface, ssd, dlib
DETECTOR_BACKEND=retinaface
